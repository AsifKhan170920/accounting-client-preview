{
  "name": "accounting-client",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only accounting client with a Canva-style invoice designer",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "test": "npm run test:app && npm run test:designer",
    "test:app": "node --test \"test/*.test.mjs\"",
    "test:designer": "npm --prefix invoice-designer test",
    "build:dist": "npm --prefix invoice-designer run build",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm test && npm run check:dist"
  }
}
